#!/bin/sh
# Защита публичного репозитория стенда.
#  - ветка etalon и теги lesson-* не публикуются никогда;
#  - тег etalon-kN публикуется только скриптом tools/publish-etalon.ps1 (он проверяет дедлайн чекпоинта);
#  - письма и транскрипт проекта (fixtures/letters, fixtures/analysis) не должны попасть в историю.
remote="$1"
z40=0000000000000000000000000000000000000000
fail=0
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/etalon|refs/heads/etalon/*)
      echo "pre-push: ветка etalon в публичный репозиторий не отправляется. Эталон открывается тегом etalon-kN после дедлайна: tools/publish-etalon.ps1" >&2
      fail=1 ;;
    refs/tags/lesson-*)
      echo "pre-push: теги lesson-NN не публикуются ($remote_ref)." >&2
      fail=1 ;;
    refs/tags/etalon-*)
      if [ "$KM_PUBLISH" != "1" ]; then
        echo "pre-push: $remote_ref публикуется только через tools/publish-etalon.ps1 (проверка дедлайна)." >&2
        fail=1
      fi ;;
  esac
  [ "$local_sha" = "$z40" ] && continue
  if [ "$remote_sha" = "$z40" ]; then
    leaked=$(git log --format= --name-only "$local_sha" --not --remotes="$remote" -- fixtures/letters fixtures/analysis 2>/dev/null | head -1)
  else
    leaked=$(git log --format= --name-only "$remote_sha..$local_sha" -- fixtures/letters fixtures/analysis 2>/dev/null | head -1)
  fi
  if [ -n "$leaked" ]; then
    echo "pre-push: в отправляемых коммитах есть данные проекта П-1 ($leaked). Они выдаются только на платформе." >&2
    fail=1
  fi
done
exit $fail
